# Salin berkas ini ke `apps/api/.env` lalu sesuaikan. `.env` diabaikan git.
#
# Host `localhost` = menjalankan Prisma/aplikasi dari mesin lokal (port 5432 dipetakan
# oleh docker-compose). Bila aplikasi berjalan di DALAM Docker, ganti host menjadi
# `db` (nama service di docker-compose.yml).
DATABASE_URL="postgresql://skm:skm_dev_password@localhost:5432/skm_db?schema=public"

# Origin frontend yang diizinkan CORS. DIATUR DI BAGIAN SSO DI BAWAH bersama
# WEB_APP_URL & redirect_uri, karena ketiganya harus konsisten satu sama lain --
# dulu terpisah di sini dan itu justru yang membuat ketiganya mudah tak sinkron.
#
# Sejarah singkat (2026-08-05 → 2026-08-27): rencana awal memakai DUA host lokal
# `api.skema.local:3001` + `app.skema.local:3000` tanpa reverse proxy. Rencana itu
# DIGANTI: sejak sesi pindah ke cookie HttpOnly, dua host berarti cookie backend
# tak terbaca frontend kecuali domainnya dilebarkan. Sekarang reverse proxy
# (infra/nginx/dev.conf) menyatukan keduanya di SATU host `skema.local`, dan
# `api.skema.local`/`app.skema.local` tak dipakai lagi.

# Rate limiting global (anti-DoS/brute-force dasar) — jumlah request per IP per jendela waktu.
# Endpoint masuk dibatasi LEBIH KETAT dari angka ini, langsung di kodenya
# (AuthController): sso/login & sso/callback 60/menit, dev-login 30/menit.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Batas harian pengaduan per akun (baku 10). Angkanya kebijakan, bukan tetapan
# teknis -- lihat complaints.constants.ts untuk alasannya.
COMPLAINT_DAILY_LIMIT=10

# Secret key Cloudflare Turnstile (captcha pengisian survei tanpa sesi).
# RAHASIA -- jangan pernah masuk repositori. Site key-nya ada di sisi web
# (NEXT_PUBLIC_TURNSTILE_SITE_KEY) dan memang boleh dipajang.
#
# Kosong = verifikasi MATI, dan itu hanya diizinkan di luar produksi:
# TurnstileService menolak menyala bila NODE_ENV=production tanpa nilai ini,
# sebab captcha yang mati diam-diam jauh lebih berbahaya daripada aplikasi yang
# menolak start.
TURNSTILE_SECRET_KEY=

# Jumlah reverse proxy TEPERCAYA di depan API (2026-08-28). Menentukan `req.ip`,
# dan lewat itu menentukan siapa yang dihitung oleh rate limiting di atas.
#
# WAJIB COCOK DENGAN TOPOLOGI, dan salah setel TIDAK menimbulkan gejala yang
# terlihat — hanya batas laju yang diam-diam berhenti bekerja per-IP:
#   1  = satu nginx di depan API (infra/nginx/dev.conf) <- keadaan sekarang
#   2  = ada load balancer/proxy lain lagi di depan nginx itu
#   0  = API diekspos langsung tanpa proxy (X-Forwarded-For sepenuhnya karangan
#        klien, jadi tak boleh dipercaya sama sekali)
#
# Kalau nilainya TERLALU KECIL, `req.ip` menjadi IP proxy — SELURUH pengguna
# masuk ke satu ember 100/menit, dan 429 menimpa orang yang tak melakukan
# apa-apa. Kalau TERLALU BESAR, klien bisa mengarang X-Forwarded-For dan memakai
# ember baru setiap permintaan — batas lajunya hilang sama sekali. Karena itu
# angka, bukan `true`: `true` berarti kasus kedua secara permanen.
TRUST_PROXY_HOPS=1

# Direktori penyimpanan lampiran pengaduan (relatif ke cwd proses api).
UPLOAD_DIR="uploads"

# Masa berlaku URL lampiran bertanda tangan, dalam detik (temuan audit T1,
# 7 September 2026). Rentang sah 60..86400; baku 3600 (1 jam).
#
# `/uploads/*` TIDAK lagi publik: backend mengembalikan `fileUrl` ber-`?exp=&sig=`
# dan permintaan tanpa itu dijawab 403. Perlu diketahui betul: URL-nya SENDIRI
# adalah kredensialnya — ia tak tahu siapa yang membukanya, jadi siapa pun yang
# memegangnya dalam masa berlaku dapat membaca lampiran itu. Angka ini
# menentukan seberapa lama URL yang bocor (log, riwayat peramban, tangkapan
# layar, `Referer`) masih berguna.
#
# Terlalu pendek juga merugikan: halaman yang dibiarkan terbuka lebih lama akan
# memuat ulang gambar dan mendapat 403, sehingga pengguna melihat lampiran rusak
# tanpa sebab yang jelas.
UPLOAD_SIGNED_URL_TTL_SECONDS=3600

# Dokumentasi Swagger di /api/docs. Bakunya `true` (berguna saat pengembangan).
# WAJIB `false` DI PRODUKSI: tanpa itu seluruh permukaan API — termasuk setiap
# endpoint admin beserta bentuk payload-nya — terpampang tanpa autentikasi.
# Ditutup di DUA tempat dengan sengaja, di sini dan lewat `location /api/docs
# { return 404; }` pada infra/nginx/prod.conf; satu lapis saja terlalu mudah
# hilang saat berkas disalin ke server baru.
SWAGGER_ENABLED=true

# Sesi lokal (JWT) — diterbitkan SKM sendiri setelah login (dev-login sekarang,
# callback SSO OAuth2 nanti — lihat AuthProvider seam). WAJIB diisi eksplisit,
# generate acak per environment (mis. `openssl rand -hex 32`), JANGAN dipakai bersama
# antar environment. Masa berlaku token dalam jam.
#
# MINIMAL 32 KARAKTER — aplikasi MENOLAK BOOT bila lebih pendek (temuan audit
# T7, 7 September 2026). Rahasia ini menandatangani seluruh token sesi; rahasia
# pendek dapat ditebak paksa di luar jaringan, tempat batas laju tak menolong,
# dan yang menemukannya bisa menerbitkan token untuk peran apa pun.
# `openssl rand -hex 32` menghasilkan 64 karakter — pakai itu.
SESSION_JWT_SECRET="ganti-dengan-string-acak-panjang"

# =====================================================================
# ENKRIPSI AT-REST (23 September 2026)
# =====================================================================
# BACA docs/keamanan/enkripsi-at-rest.md SEBELUM MENGISI DUA BARIS DI BAWAH.
#
# KEHILANGAN KUNCI BERARTI KEHILANGAN DATANYA. Bukan "sulit dipulihkan",
# melainkan hilang selamanya. Tak ada pintu belakang, dan memang tak boleh ada --
# pintu belakang yang dapat dipakai Anda dapat dipakai orang lain juga.
# Cadangkan kuncinya SEBELUM enkripsi dinyalakan, bukan sesudah.
#
# Keduanya 64 karakter heksadesimal. Buat masing-masing dengan:
#   openssl rand -hex 32
#
# Kosong di `NODE_ENV=test` jatuh ke kunci uji tetap yang tertulis di
# src/common/crypto/kunci.ts. Di `development` dan `production`, kunci yang
# kosong membuat aplikasi melempar saat kunci itu dipakai pertama kali --
# gagal nyaring, bukan menyala dengan kunci nol.

# Melindungi lampiran pengaduan di disk DAN dua kolom teks bebas paling pribadi
# di basis data (`complaints.uraian`, `complaint_replies.pesan`). Kunci ini TAK
# BOLEH meninggalkan server aplikasi.
DATA_ENCRYPTION_KEY=

# Melindungi berkas cadangan. SENGAJA TERPISAH dari kunci di atas, karena
# kustodinya berbeda: kunci ini boleh diserahkan kepada pemegang salinan luar.
#
# Perlu diketahui betul: cadangan TIDAK CUKUP untuk memulihkan sistem. Isinya
# memuat kolom dan lampiran yang terenkripsi DATA_ENCRYPTION_KEY, jadi pemulihan
# di server baru menuntut KEDUA kunci. Cadangan tanpa kunci data adalah hiasan.
BACKUP_ENCRYPTION_KEY=

# PERNYATAAN bahwa disk yang memuat direktori data PostgreSQL terenkripsi.
#
# WAJIB "true" DI PRODUKSI: tanpa itu aplikasi menolak boot. Di luar produksi
# baris ini diabaikan, jadi biarkan kosong saat mengembangkan.
#
# INI PERNYATAAN, BUKAN VERIFIKASI. PostgreSQL versi open source tak punya
# enkripsi at-rest bawaan, jadi yang melindungi berkas basis data hanyalah
# enkripsi volume di tingkat sistem operasi -- dan aplikasi tak dapat
# memeriksanya sendiri, apalagi dari dalam container. Yang dilakukan baris ini
# hanyalah memaksa seseorang menyatakannya secara sadar saat menggelar.
#
# Cara memastikannya sungguhan:
#   Windows : manage-bde -status C:
#   Linux   : lsblk -o NAME,FSTYPE,MOUNTPOINT ; cryptsetup status <perangkat>
# Selengkapnya di docs/keamanan/enkripsi-at-rest.md.
#DB_STORAGE_ENCRYPTED="true"

# UMUR SESI: dua angka, bukan satu (17 September 2026, laporan pengguna bahwa
# sesi kemarin masih dapat dipakai hari ini).
#
# SESSION_TTL_HOURS kini PAGU MUTLAK, bukan umur tetap: sesi berakhir paling
# lambat sekian jam sesudah login, berapa pun aktivitas pemiliknya. Tak dapat
# diperpanjang oleh apa pun.
#
# SESSION_IDLE_MINUTES adalah jendela MENGANGGUR: sesi yang tak dipakai selama
# sekian menit berakhir, dan setiap pemakaian memperbaruinya (dibatasi pagu di
# atas). Inilah yang membuat laptop yang ditinggal semalam kehilangan sesinya
# sementara orang yang sedang bekerja tak pernah terputus di tengah jalan.
#
# Keduanya kebijakan, bukan tetapan teknis. Makin pendek makin aman bagi
# komputer bersama, makin panjang makin jarang mengganggu.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Domain cookie sesi HttpOnly (jalur SSO). BIARKAN KOSONG di dev: cookie
# mengabaikan nomor port, jadi cookie milik host `localhost` yang disetel API di
# :3001 sudah ikut terkirim ke frontend di :3000 dengan sendirinya.
#
# DI PRODUKSI PRAKTIS WAJIB, mis. ".madiunkab.go.id". Tanpa itu cookie yang
# disetel `api.madiunkab.go.id` menjadi host-only dan TIDAK pernah sampai ke
# `skm.madiunkab.go.id` — proxy.js (Next.js, sisi server) lalu tak melihat sesi
# apa pun dan memantulkan pengguna yang sebenarnya sudah masuk.
#SESSION_COOKIE_DOMAIN=".madiunkab.go.id"

# Sumber master data OPD (Helpdesk) — dipakai HelpdeskOpdClient (POST /opd/sync).
# Opsional: tanpa ini, aplikasi tetap boot normal, tapi POST /opd/sync akan gagal
# jelas (bukan diam-diam). Endpoint mengembalikan tenant berjenjang; hanya
# type="gov" yang dipakai jadi baris OPD (lihat komentar HelpdeskOpdClient).
HELPDESK_OPD_API_URL="https://api.madiunkab.go.id/api/tenants"
HELPDESK_OPD_API_TOKEN="ganti-dengan-token-asli-dari-tim-helpdesk"

# --- SSO OAuth2 Helpdesk ---
# Opsional: tanpa client_id & client_secret, aplikasi tetap boot dan `dev-login`
# tetap jalan; hanya GET /auth/sso/login yang menolak dengan pesan jelas.
# Endpoint diambil otomatis dari <issuer>/.well-known/openid-configuration.
HELPDESK_SSO_ISSUER="https://api.madiunkab.go.id/api/oauth"
HELPDESK_SSO_CLIENT_ID="minta-ke-tim-helpdesk"
HELPDESK_SSO_CLIENT_SECRET="minta-ke-tim-helpdesk"
HELPDESK_SSO_SCOPES="openid profile email"

# Pemetaan nilai klaim Helpdesk -> peran SKM, format `nilai:peran` dipisah koma.
# KOSONG (baku) = tak ada akun baru yang dinaikkan perannya; semuanya jadi
# `responden`, dan Admin Kabupaten menaikkannya lewat Manajemen User.
#
# Ada di env, bukan di kode, KARENA bentuk klaim `groups`/`role` Helpdesk belum
# dikonfirmasi. Begitu jawabannya datang, cukup isi baris ini — tak ada kode yang
# perlu diubah. Bentuk klaim yang sesungguhnya dicatat di log level debug pada
# setiap login SSO, jadi SATU login sungguhan sudah cukup untuk mengetahuinya.
#
# ATURAN PENTING:
# - Hanya berlaku saat MEMBUAT akun baru. SSO tak pernah bisa MENURUNKAN peran
#   akun yang sudah ada — kalau tidak, Helpdesk yang berhenti mengirim klaim akan
#   diam-diam menurunkan setiap Admin Kabupaten jadi warga.
# - `superuser` TIDAK BOLEH dipetakan dan akan diabaikan. Peran itu memegang log
#   aktivitas & manajemen pengguna; penetapannya tak diserahkan ke sistem luar.
# - Peran `opd` hanya diberikan bila salah satu nilai klaim cocok dengan
#   `opd.external_id` atau `opd.kode` (tak peduli besar-kecil huruf). Bila tak
#   ada yang cocok, akun dibuat sebagai `responden` — peran OPD tanpa opdId
#   membuat dashboard-nya pasti gagal.
#HELPDESK_SSO_ROLE_MAP="admin-kab:kabupaten,admin-opd:opd"

# FIELD KLAIM YANG MEMBAWA OPD SEORANG ASN (8 September 2026).
#
# Dipakai `SsoService` untuk menautkan akun ke `users.opd_id` pada tiap login.
# Boleh beberapa nama, dipisah koma; yang lebih dahulu diperiksa lebih dahulu.
# `groups` dan `role` SELALU ikut diperiksa walau tak disebut di sini.
#
# KOSONG DI LINGKUNGAN INI, dan akibatnya sinkronisasi OPD belum pernah
# terbukti bekerja di lapangan. Yang menghalangi pengisiannya bukan kelalaian
# melainkan satu hal yang belum diketahui: BENTUK nilai klaimnya. Dokumen
# penemuan penyedia (diukur 9 September 2026 di
# https://api.madiunkab.go.id/.well-known/openid-configuration) mencantumkan
# `claims_supported`: sub, email, name, preferred_username, nickname, groups,
# role. Jadi kandidatnya tinggal DUA, yaitu `groups` dan `role`, tetapi dokumen
# itu tak menyebut apakah isinya string, larik string, atau larik objek.
#
# Cara mengetahuinya tanpa menebak: login sungguhan sekali, lalu cari baris
# "Bentuk klaim Helpdesk" di log API. Baris itu memuat bentuk setiap klaim
# tanpa satu pun nilainya (lihat src/modules/auth/sso-claim-shape.ts).
#HELPDESK_SSO_OPD_CLAIM="groups"

# JALAN KELUAR DARURAT untuk penautan akun lama lewat email (T5, 7 September 2026).
#
# Penautan akun SKEMA yang sudah ada ke identitas Helpdesk menuntut klaim
# `email_verified` bernilai true. Itu satu-satunya jalur di mana sebuah klaim SSO
# membuat pemegangnya MEWARISI peran akun lain, jadi ia gagal TERTUTUP: klaim
# yang HILANG pun ditolak.
#
# TERUKUR 9 September 2026: `claims_supported` penyedia TIDAK mencantumkan
# `email_verified`. Bila klaimnya memang tak pernah dikirim, setiap akun admin
# yang dibuat lebih dahulu lewat `POST /users` akan ditolak 403 pada login
# Helpdesk pertamanya. Menurut spesifikasi OIDC `claims_supported` hanya
# petunjuk, jadi yang memastikan tetap satu login sungguhan; baris "Bentuk klaim
# Helpdesk" di log akan menyebut `email_verified=TIDAK ADA` bila benar begitu.
# Sakelar ini BELUM diputuskan dan sengaja dibiarkan mati.
#
# Isi "true" HANYA bila ternyata Helpdesk tak mengirim klaim itu sama sekali dan
# akun-akun lama jadi tak bisa ditautkan. Setiap penautan lewat jalan ini menulis
# baris audit `sso_link_email_unverified`, jadi pemakaiannya terlacak.
# `email_verified: false` TETAP ditolak walau sakelar ini hidup — penyedia sudah
# menyatakan tidak, dan tak ada tafsir lain untuk itu.
#HELPDESK_SSO_ALLOW_UNVERIFIED_EMAIL_LINK="true"

# =====================================================================
# DUA DOMAIN YANG DIDAFTARKAN DI SSO HELPDESK
# =====================================================================
# HANYA callback BACKEND yang perlu didaftarkan. Alamat frontend
# (`WEB_APP_URL`) TIDAK didaftarkan dan Helpdesk tak perlu tahu — itu cuma
# tujuan pengalihan internal setelah backend selesai bekerja.
#
# Callback harus mendarat di BACKEND, bukan frontend, karena penukaran `code`
# menjadi token memerlukan `client_secret`. Kalau ia mendarat di frontend,
# secret itu harus ada di peramban — dan sesuatu yang ada di peramban bukan
# secret.
#
# Frontend & backend disajikan pada SATU origin lewat reverse proxy (lihat
# infra/nginx/dev.conf), sehingga tiap lingkungan cukup punya satu domain.
# Akibatnya: cookie sesi jadi host-only, CORS tak pernah terpakai, dan bentuk
# konfigurasi dev sama dengan produksi.
#
#   PENGEMBANGAN  http://skema.local/api/v1/auth/sso/callback
#   PRODUKSI      https://skema.madiunkab.go.id/api/v1/auth/sso/callback
#
# Pencocokan Helpdesk bersifat PERSIS: skema, host, port, path, dan
# ada-tidaknya garis miring akhir. `.../callback` != `.../callback/`.
#
# Perlu ditanyakan ke tim Helpdesk: bolehkah satu client punya DUA
# redirect_uri? Bila hanya satu, mintalah dua client terpisah (dev & prod) —
# itu justru lebih baik, karena secret produksi tak perlu beredar di laptop.
#
# `skema.local` butuh satu langkah manual sekali saja, tambahkan baris ini ke
# berkas hosts (Windows: C:\Windows\System32\drivers\etc\hosts, WAJIB
# run-as-administrator):
#   127.0.0.1 skema.local
# ---------------------------------------------------------------------
# PENGEMBANGAN (nilai baku berkas ini)
HELPDESK_SSO_REDIRECT_URI="http://skema.local/api/v1/auth/sso/callback"
WEB_APP_URL="http://skema.local"
CORS_ORIGIN="http://skema.local,http://localhost:3000"

# PRODUKSI — ganti keempat baris di atas & di bawah menjadi:
#HELPDESK_SSO_REDIRECT_URI="https://skema.madiunkab.go.id/api/v1/auth/sso/callback"
#WEB_APP_URL="https://skema.madiunkab.go.id"
#CORS_ORIGIN="https://skema.madiunkab.go.id"
# SESSION_COOKIE_DOMAIN TETAP KOSONG: dengan origin tunggal cookie sudah
# host-only pada domain itu dan terbaca frontend maupun backend. Mengisinya
# (mis. ".madiunkab.go.id") justru mengirim cookie sesi ke SETIAP subdomain
# kabupaten — termasuk helpdesk.* — tanpa manfaat apa pun. Ia hanya perlu
# diisi bila kelak frontend & backend dipisah ke dua subdomain.
