# Salin berkas ini ke `apps/api/.env` lalu sesuaikan. `.env` diabaikan git.
#
# Host `localhost` = menjalankan Prisma/aplikasi dari mesin lokal (port 5432 dipetakan
# oleh docker-compose). Bila aplikasi berjalan di DALAM Docker, ganti host menjadi
# `db` (nama service di docker-compose.yml).
DATABASE_URL="postgresql://skm:skm_dev_password@localhost:5432/skm_db?schema=public"

# Origin frontend yang diizinkan CORS (pisahkan koma bila lebih dari satu, mis. beda subdomain
# dashboard OPD/Kabupaten di production). Default = dev server Next.js lokal.
CORS_ORIGIN="http://localhost:3000"

# Rate limiting global (anti-DoS/brute-force dasar) — jumlah request per IP per jendela waktu.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
