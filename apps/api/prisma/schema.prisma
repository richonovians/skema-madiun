// Skema Prisma — Sistem SKM & Pengaduan Masyarakat (Diskominfo)
// Konvensi: model PascalCase (dipetakan ke tabel snake_case via @@map),
// field camelCase (dipetakan ke kolom snake_case via @map).
// Berkas ini murni struktur data — tanpa logika bisnis/auth/RBAC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUM
// =====================================================================

// `kabupaten` = Admin Kabupaten SEKALIGUS superuser (2026-08-05: role
// `superuser` terpisah DIHAPUS/digabung ke sini atas permintaan user --
// sebelumnya ditambah 20260727000000_add_superuser_role, kini dilebur
// balik). `kabupaten` mewarisi bypass penuh RolesGuard (lihat guard).
// `superuser` DIKEMBALIKAN (2026-08-20, atas permintaan user) setelah sebelumnya
// digabung ke `kabupaten` (lihat migrasi 20260805150000_remove_superuser_role_merge_kabupaten,
// yang juga atas permintaan user). Bedanya sekarang JELAS dan bukan sekadar nama:
// - superuser: seluruh hak kabupaten, DITAMBAH akses log aktivitas (audit log)
// - kabupaten: sama seperti sebelumnya, TAPI tanpa akses log aktivitas
// Perbedaan itu ditegakkan di AuditService (bukan di @Roles) karena RolesGuard
// memberi kabupaten bypass penuh atas @Roles -- lihat catatan di sana.
enum Role {
  kabupaten
  opd
  responden
  superuser

  @@map("user_role")
}

enum JenisKelamin {
  laki_laki
  perempuan

  @@map("jenis_kelamin")
}

enum SurveyStatus {
  draft
  aktif
  ditutup

  @@map("survey_status")
}

enum QuestionType {
  skala
  pilihan
  teks

  @@map("question_type")
}

enum IkmMutu {
  A
  B
  C
  D

  @@map("ikm_mutu")
}

enum ComplaintStatus {
  diterima
  diproses
  selesai
  ditolak

  @@map("complaint_status")
}

// D9 (2026-08-05): in-app saja (bukan email) -- cakupan disepakati user:
// status pengaduan berubah + balasan baru. Enum sengaja sempit sesuai
// cakupan disetujui, bukan generik "semua jenis event" yang belum diminta.
enum NotificationType {
  complaint_status_changed
  complaint_reply
  // Pengaduan baru masuk (2026-08-06, laporan bug user: OPD/kabupaten tak
  // pernah tahu ada tiket baru kecuali lewat balasan susulan) -- beri tahu
  // Admin OPD tujuan + kabupaten (oversight), TIDAK beri tahu pelapor sendiri.
  complaint_created

  @@map("notification_type")
}

// =====================================================================
// PENGGUNA & PROFIL
// =====================================================================

model User {
  id          Int       @id @default(autoincrement())
  ssoSubject  String    @unique @map("sso_subject") // identitas stabil dari Helpdesk (klaim `sub`)
  nama        String    @db.VarChar(50)
  email       String    @unique @db.VarChar(100)
  // SATU AKUN, BEBERAPA ROLE (5 September 2026). Array enum, bukan tabel
  // relasi: Admin OPD tetap tertaut SATU OPD (`opdId` di bawah), jadi tak ada
  // metadata per-role yang perlu disimpan -- dan itulah satu-satunya alasan
  // kuat memilih tabel relasi. `SessionAuthProvider` memuat baris ini pada
  // SETIAP permintaan, jadi menghindari join di jalur terpanas itu berharga.
  //
  // Minimal satu elemen; ditegakkan APLIKASI (DTO + UsersService), bukan basis
  // data -- Postgres tak punya batasan "array tak boleh kosong" yang bisa
  // dinyatakan sesederhana ini.
  //
  // Hak akses TIDAK dihitung dari kolom ini, melainkan dari peran yang sedang
  // DIPAKAI pada sesi (klaim `act`, lihat acting-role.util.ts). Kolom ini
  // menyatakan KEPEMILIKAN; sesi menyatakan PILIHAN.
  roles       Role[]
  opdId       Int?      @map("opd_id") // wajib bila `roles` memuat `opd`; null selain itu
  isActive    Boolean   @default(true) @map("is_active")
  consentAt   DateTime? @map("consent_at") // persetujuan PDP saat pertama login
  lastLoginAt DateTime? @map("last_login_at")
  deletedAt   DateTime? @map("deleted_at") // soft delete (UU PDP)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  opd               Opd?               @relation(fields: [opdId], references: [id])
  respondentProfile RespondentProfile?
  surveyResponses   SurveyResponse[]
  complaints        Complaint[]
  complaintReplies  ComplaintReply[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([opdId])
  // @@index([role]) DIBUANG bersama kolomnya. Tanpa pengganti: tabel `users`
  // di lingkungan ini berisi 7 baris. Kalau kelak tumbuh, yang dibutuhkan
  // indeks GIN (operator `has` memakai `@>`), bukan b-tree biasa.
  @@map("users")
}

model RespondentProfile {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique @map("user_id")
  jenisKelamin JenisKelamin @map("jenis_kelamin")
  kelompokUmur String       @map("kelompok_umur") @db.VarChar(20)
  pendidikan   String       @db.VarChar(20)
  pekerjaan    String       @db.VarChar(25)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("respondent_profiles")
}

// =====================================================================
// ORGANISASI PERANGKAT DAERAH (OPD)
// =====================================================================

model Opd {
  id              Int       @id @default(autoincrement())
  externalId      String?   @unique @map("external_id") // id OPD di Helpdesk (hasil sinkronisasi)
  // 80 -> 150 (INT-HD-1): nama OPD gabungan asli dari Helpdesk bisa >80 karakter
  // (mis. "Dinas Pengendalian Penduduk dan Keluarga Berencana, Pemberdayaan
  // Perempuan dan Perlindungan Anak" = 97 karakter) -- ketahuan saat sinkronisasi
  // nyata pertama kali dicoba, bukan diasumsikan dari awal.
  nama            String    @db.VarChar(150)
  kode            String    @unique @db.VarChar(10)
  jenisLayanan    String?   @map("jenis_layanan") @db.VarChar(50)
  penanggungJawab String?   @map("penanggung_jawab") @db.VarChar(40)
  isActive        Boolean   @default(true) @map("is_active")
  syncedAt        DateTime? @map("synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  users      User[]
  surveys    Survey[]
  complaints Complaint[]

  @@map("opd")
}

// =====================================================================
// SURVEI & PERTANYAAN
// =====================================================================

model Survey {
  id                  Int          @id @default(autoincrement())
  opdId               Int          @map("opd_id")
  judul               String       @db.VarChar(100)
  periode             String       @db.VarChar(20)
  status              SurveyStatus @default(draft)
  allowMultipleSubmit Boolean      @default(false) @map("allow_multiple_submit")
  // Pengisian TANPA sesi (4 September 2026). Baku `false`, sehingga seluruh
  // survei yang sudah ada tidak berubah perilakunya sedikit pun. Hanya
  // endpoint /public/surveys/* yang membacanya.
  izinkanAnonim       Boolean      @default(false) @map("izinkan_anonim")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  opd        Opd              @relation(fields: [opdId], references: [id])
  questions  Question[]
  responses  SurveyResponse[]
  ikmResults IkmResult[]

  @@index([opdId])
  @@index([status])
  @@map("surveys")
}

model Question {
  id         Int          @id @default(autoincrement())
  surveyId   Int          @map("survey_id")
  teks       String       @db.Text
  tipe       QuestionType
  isIkmUnsur Boolean      @default(false) @map("is_ikm_unsur")
  kodeUnsur  String?      @map("kode_unsur") @db.VarChar(5) // U1..U9; null jika kustom
  urutan     Int
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  survey  Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers Answer[]

  @@index([surveyId])
  @@map("questions")
}

// Opsi untuk pertanyaan tipe `pilihan`. Struktur disiapkan sekarang;
// fitur pilihan ganda diimplementasikan pada Fase 3.
model QuestionOption {
  id         Int    @id @default(autoincrement())
  questionId Int    @map("question_id")
  label      String @db.VarChar(255)
  nilai      Int? // skor opsi bila berkontribusi ke perhitungan
  urutan     Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([questionId])
  @@map("question_options")
}

// =====================================================================
// PENGISIAN SURVEI
// =====================================================================

model SurveyResponse {
  id           Int      @id @default(autoincrement())
  surveyId     Int      @map("survey_id")
  // NULL = respons anonim (tanpa sesi). Ditelusuri sebelum diubah: satu-satunya
  // pembaca kolom ini adalah ResponsesService (submit & findMine); IKM maupun
  // dashboard hanya count(), jadi respons tanpa pemilik tak merusak perhitungan.
  userId       Int?     @map("user_id")
  // Anti-duplikat: diisi = userId bila survei TIDAK mengizinkan multi-submit,
  // null bila boleh berulang. Postgres memperlakukan NULL sebagai distinct,
  // sehingga @@unique di bawah = 1 respons/user saat single-submit, tak dibatasi saat multi.
  dedupeUserId Int?     @map("dedupe_user_id")
  submittedAt  DateTime @default(now()) @map("submitted_at")
  // Disiapkan untuk persetujuan UU PDP bagi pengirim anonim. BELUM DIPAKAI --
  // menunggu konfirmasi tim Diskominfo; selalu NULL sampai saat itu. Ada di
  // migrasi yang sama supaya konfirmasinya tak menuntut migrasi kedua.
  consentAt    DateTime? @map("consent_at")

  survey  Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])
  answers Answer[]

  @@unique([surveyId, dedupeUserId])
  @@index([surveyId])
  @@index([userId])
  @@map("survey_responses")
}

model Answer {
  id               Int     @id @default(autoincrement())
  responseId       Int     @map("response_id")
  questionId       Int     @map("question_id")
  nilai            Int? // untuk tipe skala (1-4)
  teks             String? @db.Text // untuk tipe teks/saran
  selectedOptionId Int?    @map("selected_option_id") // untuk tipe pilihan (Fase 3)

  response       SurveyResponse  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id])
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([responseId, questionId]) // satu jawaban per pertanyaan per respons
  @@index([questionId])
  @@index([selectedOptionId])
  @@map("answers")
}

// =====================================================================
// HASIL IKM (ringkasan/snapshot per periode)
// =====================================================================

model IkmResult {
  id              Int      @id @default(autoincrement())
  surveyId        Int      @map("survey_id")
  periode         String   @db.VarChar(20)
  nrrPerUnsur     Json     @map("nrr_per_unsur") // fleksibel terhadap perubahan jumlah unsur
  nilaiIkm        Decimal  @map("nilai_ikm") @db.Decimal(5, 2)
  mutu            IkmMutu
  jumlahResponden Int      @map("jumlah_responden")
  dihitungPada    DateTime @default(now()) @map("dihitung_pada")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, periode]) // satu hasil per survei per periode (di-upsert saat dihitung ulang)
  @@map("ikm_results")
}

// =====================================================================
// STATISTIK PUBLIK (D6, 2026-08-05)
// =====================================================================

// Narasi `insight.text` di halaman /statistics publik -- keputusan D6:
// disediakan tempat penyimpanan agar bisa diisi ADMIN (bukan dihapus dari UI,
// bukan auto-generated dari angka). Baris tunggal (`id` selalu 1, di-upsert),
// bukan tabel riwayat -- cukup satu narasi aktif pada satu waktu.
model StatisticsInsight {
  id        Int      @id @default(1)
  text      String   @db.Text
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("statistics_insight")
}

// =====================================================================
// PENGADUAN
// =====================================================================

model Complaint {
  id          Int             @id @default(autoincrement())
  ticketNo    String          @unique @map("ticket_no") @db.VarChar(20) // identifier publik
  userId      Int             @map("user_id")
  opdId       Int             @map("opd_id")
  kategori    String          @db.VarChar(50) // 'aduan' | 'lapor' | 'lainnya' -- COMPLAINT_CATEGORIES
  judul       String          @db.VarChar(255)
  uraian      String          @db.Text
  status      ComplaintStatus @default(diterima)
  // Pengiriman anonim (4 September 2026). Basis data TETAP menyimpan userId
  // sebenarnya -- penyamaran terjadi di lapisan entity, supaya tautan pelapor
  // tetap ada untuk eskalasi resmi lewat audit_logs.
  isAnonim    Boolean         @default(false) @map("is_anonim")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user        User                  @relation(fields: [userId], references: [id])
  opd         Opd                   @relation(fields: [opdId], references: [id])
  replies     ComplaintReply[]
  attachments ComplaintAttachment[]

  @@index([userId])
  @@index([opdId])
  @@index([status])
  @@map("complaints")
}

// Lampiran pengaduan (multi-file) — menggantikan kolom tunggal `lampiran`.
model ComplaintAttachment {
  id          Int      @id @default(autoincrement())
  complaintId Int      @map("complaint_id")
  // `replyId` (2026-08-06, laporan bug user "tidak bisa mengirim dokumen/foto
  // di chat"): opsional -- NULL bila lampiran milik pengajuan awal (create()),
  // terisi bila lampiran disertakan pada satu balasan chat (addReply()).
  // `complaintId` TETAP diisi pada kedua kasus (bukan diturunkan dari reply)
  // supaya query akses/kepemilikan (assertAccess by opdId/userId) tak perlu
  // join tambahan lewat reply.
  replyId     Int?     @map("reply_id")
  fileUrl     String   @map("file_url") @db.VarChar(500)
  mimeType    String?  @map("mime_type") @db.VarChar(100)
  sizeBytes   Int?     @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  complaint Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  reply     ComplaintReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([replyId])
  @@map("complaint_attachments")
}

model ComplaintReply {
  id          Int      @id @default(autoincrement())
  complaintId Int      @map("complaint_id")
  authorId    Int      @map("author_id")
  pesan       String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  complaint   Complaint             @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author      User                  @relation(fields: [authorId], references: [id])
  attachments ComplaintAttachment[]

  @@index([complaintId])
  @@index([authorId])
  @@map("complaint_replies")
}

// =====================================================================
// NOTIFIKASI (D9, in-app, 2026-08-05)
// =====================================================================

// Baris per-penerima (bukan event bersama disebar) -- lebih sederhana utk
// query "punya berapa belum dibaca" & tandai-dibaca per pengguna, sepadan
// dgn skala pemakaian (bukan broadcast massal).
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(150)
  message   String           @db.VarChar(500)
  link      String?          @db.VarChar(255) // path relatif frontend, mis. /complaints/PGD...
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =====================================================================
// AUDIT
// =====================================================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int      @map("actor_id")
  aksi      String   @db.VarChar(30)
  entitas   String   @db.VarChar(25)
  detail    Json?
  timestamp DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entitas])
  @@map("audit_logs")
}
