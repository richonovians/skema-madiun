node_modules/
.env
.env.*
!.env.example
dist/
# Keluaran kompilasi pelari uji beban; dipisah dari `dist/` agar tak menimpa
# milik `nest start --watch`.
dist-beban/
.next/
# Keluaran build untuk uji E2E (apps/web/scripts/server-e2e.mjs). Terpisah dari
# .next supaya build pengujian tak menimpa milik server pengembangan.
.next-e2e/

# Keadaan masuk Playwright (`apps/web/e2e/.auth/`). Isinya token sesi JWT hasil
# dev-login, satu per peran, supaya suite E2E tak perlu masuk ulang tiap berkas.
# Kedaluwarsa pun bentuknya tetap kredensial, dan sekali masuk riwayat git ia
# tersalin ke setiap klona; membersihkannya menuntut penulisan ulang cabang.
.auth/
coverage/
*.log

# Proyek pakai pnpm (pnpm-lock.yaml di root) -- package-lock.json (npm)
# tak sengaja kebuat kalau ada yang jalanin `npm install` alih-alih `pnpm
# install`, jangan sampai ke-commit lagi (INT-28).
package-lock.json
# Dokumen kerja skill "superpowers" (spec & rencana implementasi). Berguna
# selama pengerjaan, tapi bukan dokumentasi produk -- tak perlu masuk GitLab.
docs/superpowers/

# Dokumen rancangan keamanan: berhenti dilacak 15 Oktober 2026 atas permintaan
# pemilik repo. Repo ini PUBLIK (api.github.com menjawab 200 tanpa kredensial),
# dan dokumen-dokumen ini memetakan model ancaman, cakupan enkripsi, kebijakan
# retensi, serta pertanyaan integrasi Helpdesk yang masih terbuka.
#
# CATATAN YANG TAK BOLEH HILANG: aturan ini hanya menghentikan commit
# BERIKUTNYA. Kelima berkasnya sudah pernah di-push, jadi isinya tetap terbaca
# di riwayat publik; riwayat sengaja TIDAK ditulis ulang.
#
# docs/keamanan/enkripsi-at-rest.md adalah runbook pemulihan dan rotasi
# DATA_ENCRYPTION_KEY, dan kehilangan kunci itu berarti lampiran serta isi
# pengaduan hilang PERMANEN. Sejak aturan ini berlaku, remote bukan lagi
# salinannya -- simpan salinan tahan lama di luar repo.
docs/keamanan/

# Setelan Claude Code per-mesin. `.claude/skills/` dan `.claude/settings.json`
# SENGAJA tercatat: isinya aturan kerja proyek yang harus berlaku bagi siapa
# pun yang mengklona repo ini. Yang dikecualikan hanya berkas `*.local.*`,
# yang memuat keputusan izin milik satu pengembang, bukan aturan proyek.
.claude/**/*.local.*

# Cadangan basis data & lampiran (23 September 2026).
#
# Terenkripsi, dan itu TETAP bukan alasan untuk menaruhnya di repositori.
# Riwayat git disalin ke setiap klona dan sering berakhir di forge yang
# aksesnya lebih luas daripada server aslinya; sebuah cadangan di sana adalah
# seluruh basis data yang menunggu satu kunci bocor. Cadangan disimpan DI LUAR
# repositori, beserta kedua kuncinya.
cadangan/

qa-bug-hunt/
