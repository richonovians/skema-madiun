# =====================================================================
# Contoh variabel lingkungan — salin ke `.env` lalu sesuaikan nilainya.
# `.env` diabaikan git (lihat .gitignore) agar rahasia tidak masuk repo.
# Docker Compose otomatis memuat `.env` dari root proyek.
# =====================================================================

# --- PostgreSQL (dipakai service `db` di docker-compose.yml) ---
POSTGRES_USER=skm
POSTGRES_PASSWORD=skm_dev_password
POSTGRES_DB=skm_db
POSTGRES_PORT=5432

# --- Port service (diaktifkan saat api & web ditambahkan) ---
# API_PORT=3001
# WEB_PORT=3000

# --- Koneksi database untuk service api (diisi saat Prisma dikonfigurasi) ---
# Host `db` = nama service (akses antar-container di network yang sama).
# Untuk akses dari host/lokal gunakan `localhost`.
# DATABASE_URL="postgresql://skm:skm_dev_password@db:5432/skm_db?schema=public"
